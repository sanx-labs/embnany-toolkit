# 复制为 .env 后填写真实值：cp .env.example .env
# .env 已被 .gitignore / .vercelignore 忽略，切勿把真实密钥提交到 Git。
#
# 线上请在 Vercel → Project → Settings → Environment Variables 配置同名变量
#（Production / Preview），不要写进前端 JS。

# Notion Integration Secret（ntn_ 或 secret_ 开头）
NOTION_API_KEY=your_notion_integration_secret_here

# SCHEDULE 数据库 ID（32 位，来自 Notion 数据库 URL）
NOTION_SCHEDULE_DATABASE_ID=your_32_char_database_id_here

# EMV 待办数据库 ID（Artist / Handle / Event / Account Type / View Post / Status）
NOTION_EMV_DATABASE_ID=your_32_char_emv_database_id_here

# VOTE 投票追踪数据库 ID
NOTION_VOTE_DATABASE_ID=your_32_char_vote_database_id_here
# 可选：VOTE 数据库字段名与默认值不一致时再配置
# NOTION_VOTE_PROP_TITLE=Title
# NOTION_VOTE_PROP_STATUS=Status
# NOTION_VOTE_PROP_PERIOD=Voting Period
# NOTION_VOTE_PROP_PLATFORM=Platform
# NOTION_VOTE_PROP_FREQUENCY=Frequency
# NOTION_VOTE_PROP_ARTIST=Artist
# NOTION_VOTE_PROP_ORGANIZER=Organizer
# NOTION_VOTE_PROP_VOTE_URL=Vote URL
# NOTION_VOTE_PROP_VIEW_RESULTS=View Results
# NOTION_VOTE_DATA_SOURCE_ID=

# 可选：跳过 database → data_source 解析
# NOTION_DATA_SOURCE_ID=

# 可选：列名与默认值不一致时再改
# NOTION_PROP_TITLE=Title
# NOTION_PROP_DATE=Date
# NOTION_PROP_LOCATION=Location
# NOTION_PROP_GUESTS=People
# NOTION_PROP_KEYWORD=Trending Keyword
# NOTION_PROP_HASHTAG=Hashtag
# NOTION_PROP_OFFICIAL_URL=Official Post
