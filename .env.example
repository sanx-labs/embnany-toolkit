# 复制为 .env 后填写真实值：cp .env.example .env
# .env 已被 .gitignore / .vercelignore 忽略，切勿把真实密钥提交到 Git。
#
# 线上请在 Vercel → Project → Settings → Environment Variables 配置同名变量
#（Production / Preview），不要写进前端 JS。

# Notion Integration Secret（ntn_ 或 secret_ 开头）
NOTION_API_KEY=your_notion_integration_secret_here

# 数据库 ID（32 位，来自 Notion 数据库 URL）
NOTION_DATABASE_ID=your_32_char_database_id_here

# 可选：跳过 database → data_source 解析
# NOTION_DATA_SOURCE_ID=

# 可选：列名与默认值不一致时再改
# NOTION_PROP_TITLE=Title
# NOTION_PROP_DATE=Date
# NOTION_PROP_LOCATION=Location
# NOTION_PROP_GUESTS=People
# NOTION_PROP_KEYWORD=Trending Keyword
# NOTION_PROP_HASHTAG=Hashtag
# NOTION_PROP_OFFICIAL_URL=Official Post
